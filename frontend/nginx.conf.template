events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    server {
        listen ${PORT};
        server_name localhost;

        # Docker 内置 DNS（user-defined / compose 网络均有）；配合变量 proxy_pass，
        # 在请求时再解析 upstream，避免容器启动瞬间 backend 未就绪导致 nginx 直接 [emerg] 退出。
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $backend_host ${BACKEND_HOST};

        # Allow larger uploads (PDF/Word/Excel/images). Default is 1m which triggers 413.
        client_max_body_size 50m;

        root /usr/share/nginx/html;
        index index.html index.htm;

        location = /index.html {
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";
            add_header Expires "0";
        }

        location /assets/ {
            try_files $uri =404;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        # 与后端裸路由 GET /health 对齐（负载均衡 / 平台探活）
        location = /health {
            proxy_pass http://$backend_host:3000/health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }

        # SSE / chunked 流式：须关闭缓冲与 gzip，并拉长读超时，否则浏览器常见
        # net::ERR_INCOMPLETE_CHUNKED_ENCODING（连接被代理提前关断）。
        location /api/ai/generate/stream {
            proxy_pass http://$backend_host:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection '';
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cache off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            send_timeout 3600s;
            gzip off;
        }

        # 需求分析 SSE（与 generate/stream 相同代理策略，否则会被 location /api 缓冲截断）
        location /api/ai/analyze/stream {
            proxy_pass http://$backend_host:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection '';
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cache off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            send_timeout 3600s;
            gzip off;
        }

        # 文档解析进度 SSE（GET /api/files/:id/parse-events）；须与流式接口同样关闭缓冲，否则浏览器常见
        # net::ERR_INCOMPLETE_CHUNKED_ENCODING。
        location ~ ^/api/files/[^/]+/parse-events$ {
            proxy_pass http://$backend_host:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection '';
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cache off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            send_timeout 3600s;
            gzip off;
        }

        location /api {
            proxy_pass http://$backend_host:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection '';
            # 普通 API 也可能较慢（大模型非流式）
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        gzip on;
        gzip_vary on;
        gzip_min_length 1024;
        gzip_proxied any;
        gzip_comp_level  6;
        gzip_types
            text/plain
            text/css
            text/xml
            text/javascript
            application/javascript
            application/xml+rss
            application/json;
    }
}
