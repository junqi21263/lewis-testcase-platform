{
  "name": "testcase-platform-backend",
  "version": "1.0.0",
  "description": "AI 测试用例生成平台后端",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prod.prisma",
    "postinstall": "prisma generate --schema=./prisma/schema.prod.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "verify:auth-flow": "pnpm exec prisma generate --schema=./prisma/schema.prod.prisma && ts-node scripts/verify-auth-flow.ts",
    "test:smtp": "ts-node scripts/test-smtp-send.ts",
    "smoke:enhancements": "ts-node scripts/smoke-enhancements.ts",
    "smoke:hunyuan-pdf": "pnpm exec ts-node scripts/smoke-hunyuan-pdf.ts",
    "debug:file-parse": "pnpm exec ts-node scripts/debug-file-parse.ts",
    "smoke:export-analysis-pdf": "pnpm exec ts-node -r tsconfig-paths/register scripts/smoke-export-analysis-pdf.ts",
    "user:reset-password": "ts-node scripts/reset-user-password.ts",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --testPathPattern=test/"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.18.0",
    "axios": "^1.15.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "openai": "^4.56.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-parse": "^1.1.1",
    "pdf-to-img": "4.5.0",
    "pdfkit": "^0.18.0",
    "prisma": "^5.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "tencentcloud-sdk-nodejs": "^4.1.0",
    "tesseract.js": "^5.1.0",
    "uuid": "^11.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "prisma",
      "@prisma/engines"
    ],
    "overrides": {
      "@angular-devkit/core>ajv": "^8.18.0",
      "@xmldom/xmldom": "^0.8.13",
      "ajv-formats>ajv": "^8.18.0",
      "canvas": "3.2.1",
      "conf>ajv": "^8.18.0",
      "fast-uri": "^3.1.2",
      "fast-xml-parser": "^5.7.0",
      "lodash": "^4.18.1",
      "js-yaml": "4.1.1",
      "multer": "^2.1.1",
      "request": "npm:@cypress/request@^3.0.7",
      "tmp": "^0.2.5",
      "tough-cookie": "^4.1.4",
      "uuid": "11.1.1",
      "webpack": "^5.106.2"
    }
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.3.10",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.16.1",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.17.6",
    "@types/jest": "^29.5.14",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
