# 数据库（示例不含口令；本地请填写密码或使用无密码 URI，仅作占位）
DATABASE_URL="postgresql://testcase_user@localhost:5432/testcase_db"

# JWT
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# 默认管理员（用于 prisma seed）
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
# 管理员模式：关闭注册/找回密码/邮件验证码（生产默认开启；设为 false 可关闭）
# AUTH_ADMIN_ONLY=true
# 紧急恢复：users.password 若为明文且与登录密码完全一致，设 1 可登录并自动写回 bcrypt（用完请改回 0 或删除）
# AUTH_ALLOW_PLAINTEXT_PASSWORD=0

# AI 配置（OpenAI 兼容接口）
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
DEFAULT_AI_MODEL="gpt-4o"

# 上传图片 / PDF 的视觉理解（多模态，OpenAI 兼容 chat.completions + image_url）
# 优先在「系统设置」里勾选模型的「文档视觉解析」；也可用环境变量强制指定配置 id：
# VISION_PARSE_MODEL_CONFIG_ID="cuid-of-ai_model_configs"
# PDF：提取文本少于该字数时走分页 OCR/视觉（依赖 pdf-to-img/canvas，见部署说明）
# VISION_PDF_MIN_TEXT_CHARS=120
# 文本层乱码字符占比超过该阈值（0–1）则启用 OCR，默认 0.3
# PDF_TEXT_GARBLED_RATIO_MAX=0.3
# 设为 1 时历史上会强制首页视觉；现已改为「仅当文本层不足时才 OCR」，文本已充足时忽略此项以免大 PDF 误调用多模态
# VISION_PDF_ALWAYS=0
# PDF 首页转图分辨率系数（pdf-to-img/canvas）；过大易 OOM，过小影响识别，默认 1.2
# VISION_PDF_RENDER_SCALE=1.2
# 视觉 API 超时（毫秒），默认 120000
# VISION_API_TIMEOUT_MS=120000
# 单张图片（上传 PNG/JPG）视觉调用超时（毫秒），默认 90000；短于全局 PDF 管线以免阻塞感过重
# VISION_IMAGE_TIMEOUT_MS=90000
# 单图 image_url detail：low 更快、省 token（默认）；截图/UI 通常足够。精细图纸可设 high 或 auto
# VISION_IMAGE_DETAIL=low
# 多模态已有有效正文时跳过本机 Tesseract（大分辨率 PNG 上 OCR 常耗时数分钟）；设为 0 恢复「视觉后仍跑 OCR」
# IMAGE_PARSE_SKIP_OCR_WHEN_VISION_OK=1
# 仍跑 OCR 时的超时（毫秒），防止单任务无限占用 worker，默认 60000
# IMAGE_OCR_TIMEOUT_MS=60000
# 多模态解析正文已含抽取结果时，跳过「需求结构化」第二轮默认模型 LLM（显著提速）；设为 1 强制始终调用结构化 LLM
# STRUCTURE_LLM_FOR_VISION_DOC=0
# 分页 OCR：每批页数、全局并发批次数（单批内顺序；批之间并行受限）
# PDF_OCR_BATCH_SIZE=5
# PDF_OCR_MAX_CONCURRENT_BATCHES=2
# 跳过多模态、仅用 Tesseract（部署无可用视觉模型时可设 1）
# PDF_OCR_SKIP_VISION=0
# 每个分片（批次或单页）失败自动重试次数（不含首次），间隔秒
# PDF_OCR_SHARD_RETRIES=2
# PDF_OCR_SHARD_RETRY_DELAY_MS=5000

# 超大 PDF：总页数超过阈值时，识别完前若干页后先写入部分正文再继续（uploaded_files.parseProgress.incremental）
# PDF_INCREMENTAL_THRESHOLD_PAGES=50
# PDF_INCREMENTAL_SNAPSHOT_PAGES=10

# 可选：自建 PaddleOCR HTTP 服务（POST /ocr，body JSON含 image_base64，响应 JSON 含 text）
# PADDLE_OCR_SERVICE_URL=http://127.0.0.1:8868
# PADDLE_OCR_TIMEOUT_MS=120000

# 前端可通过 GET /files/:id/parse-events（SSE）订阅解析进度；轮询 getFileById 亦可取得 parseProgress

# OCR：tesseract 语言包。繁体图片建议启用 chi_tra；默认 chi_sim+chi_tra+eng
# OCR_LANGS=chi_sim+chi_tra+eng

# ---------- 图片 OCR 加速（sharp 预处理 + 缓存 + Worker 池 + 竖向分块；需安装 sharp）----------
# IMAGE_OCR_MAX_WIDTH=1920
# IMAGE_OCR_JPEG_QUALITY=80
# IMAGE_OCR_MAX_OUTPUT_BYTES=512000
# IMAGE_OCR_CHUNK_MAX_HEIGHT=2000
# IMAGE_OCR_MAX_CONCURRENT=3
# IMAGE_OCR_WORKER_POOL=2
# IMAGE_OCR_AUTO_RETRIES=2
# IMAGE_OCR_CACHE_ENABLED=1
# IMAGE_OCR_CACHE_TTL_DAYS=7
# IMAGE_OCR_CACHE_SWEEP_MS=600000
# IMAGE_OCR_WARMUP=1
# 可选：自建服务 POST 原始 JPEG body，返回 JSON {"text":"..."}，与 Paddle 二选一或并存
# TENCENT_OCR_HTTP_URL=
# TENCENT_OCR_HTTP_TIMEOUT_MS=60000
# 文本层不足时，是否优先对整本 PDF 逐页走腾讯云 OCR（需已配置 URL）；设为 0 则仅用原视觉/Tesseract 分批管线
# PDF_TENCENT_OCR_ENABLED=1
# 腾讯云 PDF 单页识别失败自动重试次数（不含首次）
# PDF_TENCENT_OCR_PAGE_RETRIES=2

# ---------- 腾讯云 OCR 官方 SDK（PDF：GeneralBasicOCR + IsPdf + PdfPageNumber；COS 签名 URL 免本机渲染）----------
# OCR 调用优先读 TENCENTCLOUD_SECRET_*；未单独配置时自动回退为 COS_SECRET_*（与对象存储同一子账号时可只配 COS）
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# 未设置时回退 COS_REGION
# TENCENT_OCR_REGION=ap-guangzhou
# 设为 0 关闭「优先 SDK PDF」
# PDF_TENCENT_SDK_PDF=1
# 仅本地 PDF 走 Base64 时的最大字节（默认 4MB；超大请用 COS 上传 + cos://）
# PDF_TENCENT_SDK_MAX_BYTES=4194304
# pdf-parse 未返回页数时最多探测页数
# PDF_TENCENT_SDK_MAX_PROBE_PAGES=200
# COS 签名 URL 有效期（秒），供 OCR ImageUrl 拉取
# TENCENT_OCR_COS_URL_EXPIRES_SEC=7200

# 文件上传
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# ---------- 腾讯云 COS（可选：SecretId+Key+Bucket+Region 齐全时，新上传会先落盘再上传 COS，DB.path 为 cos://…）----------
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=your-bucket-appid
# COS_REGION=ap-guangzhou
# COS_PREFIX=ai-uploads/
# 注意：不要在同一行值后写「 # 注释」，否则可能被拼进 COS object key；注释请单独起一行。
# 解析前临时文件目录（默认系统临时目录，Linux 多为 /tmp）；解析后会删除
# COS_PARSE_TEMP_DIR=/tmp
#
# ---------- 混元 OpenAI 兼容多模态（推荐：图片/PDF 直读，axios + Bearer，模型 hunyuan-vision）----------
# HUNYUAN_MULTIMODAL_ENABLED=1
# HUNYUAN_VISION_API_KEY=sk-你的混元API密钥
# 可选：须为「完整 chat/completions URL」（代码直接 POST 到此地址）。若只写 https://.../v1 会 404
# HUNYUAN_OPENAI_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1/chat/completions
# 单次请求超时（毫秒，默认 180000）
# HUNYUAN_OPENAI_TIMEOUT_MS=180000
# HUNYUAN_MULTIMODAL_MODEL=hunyuan-vision
# HUNYUAN_MULTIMODAL_TEMPERATURE=0.1
#
# ---------- 兼容旧开关（与 HUNYUAN_MULTIMODAL_ENABLED 二选一即可）----------
# HUNYUAN_COS_MULTIMODAL_PARSE_ENABLED=0
# COS 签名 URL 有效期（秒）；仅当解析链路仍依赖 COS 预签名时有效
# HUNYUAN_COS_URL_EXPIRES_SEC=7200
# 混元 API 地区（部分旧链路）
# HUNYUAN_REGION=ap-guangzhou
# 单次请求 HTTP 超时（秒，旧变量名；新代码优先读 HUNYUAN_OPENAI_TIMEOUT_MS）
# HUNYUAN_MULTIMODAL_REQ_TIMEOUT_SEC=180
# 超过该体积（MB）跳过多模态直读；PDF 默认 40、图片默认 18；设为 0 表示不设上限
# HUNYUAN_COS_MULTIMODAL_MAX_PDF_MB=40
# HUNYUAN_COS_MULTIMODAL_MAX_IMAGE_MB=18
# 返回正文过短则视为失败并降级（图片 / PDF）
# HUNYUAN_COS_MULTIMODAL_MIN_OUTPUT_CHARS=40
# HUNYUAN_COS_MULTIMODAL_MIN_OUTPUT_CHARS_PDF=40
# 强制模式（默认 1）：图片/PDF 禁用本地视觉/Tesseract，只允许「混元 -> 腾讯云 OCR」链路
# HUNYUAN_PARSE_FORCE_ONLY=1
#
# 文件解析强制混元（FILE_PARSE 阶段）：=1 时
# - 不因「多模态总开关关闭 / 超预算自动降级」在入口处跳过混元直读；
# - 与「仅提取内置文本」重试互斥（会报错）。
# FILE_PARSE_FORCE_HUNYUAN=0
#
# 混元失败后是否允许腾讯云 OCR/PDF 兜底（默认不设=不允许，上传解析统一走混元）：
# FILE_PARSE_TENCENT_OCR_FALLBACK=1

# ==== Multimodal Runtime Config (env > db > default) ====
# MM_ENABLED=1
# MM_DEFAULT_MODEL=hunyuan-vision
# MM_TEXT_FALLBACK_MODEL=hunyuan-pro
# MM_MAX_CONCURRENT=3
# MM_CACHE_TTL_DAYS=7
# MM_MONTHLY_ALERT_CNY=10
# MM_AUTO_DOWNGRADE_WHEN_OVER_BUDGET=0
# MM_PRICE_MULTIMODAL_INPUT_1K_CNY=0.0
# MM_PRICE_MULTIMODAL_OUTPUT_1K_CNY=0.0
# MM_PRICE_TEXT_INPUT_1K_CNY=0.0
# MM_PRICE_TEXT_OUTPUT_1K_CNY=0.0

# ---------- 轻量云专属磁盘治理（腾讯云轻量等磁盘紧张环境：设为 1 启用）----------
# 解析完成的 PDF 源文件保留天数（默认 3；COS 与本地均会清理对象/文件，parsedContent 仍保留）
# LIGHTWEIGHT_UPLOAD_RETENTION_DAYS=3
# 别名（与上一项二选一，代码中会回退）：PDF_RETENTION_DAYS=3
# 未合并的分片临时目录超过此时长删除（小时，默认 48）
# LIGHTWEIGHT_ORPHAN_CHUNK_MAX_AGE_HOURS=48
# OCR/模型缓存根目录（逗号分隔）；目录内按修改时间只保留最近 N 项，勿指向 node_modules
# LIGHTWEIGHT_MODEL_CACHE_ROOTS=/data/tesseract-cache
# LIGHTWEIGHT_MODEL_CACHE_KEEP=1
# 磁盘占用阈值（%），超过则触发与每日任务相同的清理 + 下方 shell 脚本（默认 85）
# LIGHTWEIGHT_DISK_THRESHOLD_PERCENT=85
# 别名：DISK_CLEANUP_THRESHOLD=75
# df 检查路径（默认 /）
# LIGHTWEIGHT_DISK_CHECK_PATH=/
# 自定义清理脚本（默认 backend/scripts/lightweight-cloud-cleanup.sh，用于日志轮转与过期归档）
# LIGHTWEIGHT_CLEANUP_SCRIPT_PATH=/app/scripts/lightweight-cloud-cleanup.sh
# 若将 stdout 重定向到文件，可配合轮转（字节阈值默认 100MB、保留天数默认 3）：
# APP_LOG_FILE=/var/log/testcase-app.log
# APP_LOG_DIR=/var/log
# LIGHTWEIGHT_LOG_MAX_BYTES=104857600
# LIGHTWEIGHT_LOG_RETENTION_DAYS=3

# 应用配置
APP_PORT=3000
NODE_ENV=development
# 日志采集里若出现 \\u001b 等 ANSI 转义，可在 Railway 设 NO_COLOR=1（或 FORCE_COLOR=0）
# NO_COLOR=1
# Railway：由平台注入 PORT，须与 Networking「转发到端口」一致；不要设置 HOST=127.0.0.1 或 localhost（会 502）

# 限流配置（每分钟最大请求数）
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# 提示词模板列表 GET /api/templates 进程内缓存（毫秒）。创建/更新/删除模板会清空缓存。
# 不设或留空：生产默认 30s，开发/测试默认关闭；显式 0=关闭。
# TEMPLATES_LIST_CACHE_TTL_MS=
# 多实例时列表缓存用 Redis 存条目 + 版本号，与进程内 Map 二选一（需 REDIS_URL 且本项为 1）
# REDIS_URL=redis://127.0.0.1:6379
# TEMPLATES_LIST_CACHE_REDIS=0

# 文档解析后台 Worker（files 模块轮询 PENDING；设为 0 可关闭 worker）
# FILE_PARSE_WORKER_ENABLED=1
# FILE_PARSE_WORKER_INTERVAL_MS=1500
# 后台解析 worker 最大并发（默认 3，上限 16）；多图/PDF 排队时可并行混元
# FILE_PARSE_WORKER_MAX_CONCURRENT=3
# FILE_PARSE_TIMEOUT_MINUTES=15

# CORS：浏览器里的「前端站点」Origin（协议+主机+端口，不要带路径）。默认同 src/config/cors.config.ts
# 非 production 时自动放行 http(s)://localhost 与 127.0.0.1 任意端口（含 Vite 随机端口）。
# 若本地误设 NODE_ENV=production，浏览器仍报 CORS：任选其一 ——
#   CORS_ALLOW_LOCALHOST=1
#   或在 CORS_ORIGINS 写入完整 Origin（如 http://localhost:58385）
# 注册验证邮件、忘记密码邮件里的链接依赖 FRONTEND_URL（须与线上前端一致，不要末尾斜杠）
# FRONTEND_URL=https://<your-frontend-domain>
# 多个来源用英文逗号分隔：
# CORS_ORIGINS=https://a.com,https://b.com

# 邮件（注册 / 忘记密码为「邮箱 6 位验证码」；与 FRONTEND_URL 无关）
#
# ---------- Railway：出站 SMTP 限制（Connection timeout 常见根因）----------
# Free / Trial / Hobby 计划：官方禁用出站 SMTP（25/465/587），直连 Outlook 会一直超时，与账号密码无关。
# 二选一：① 升级到 Pro+ 并重新部署后再用下方 SMTP；② 使用 Resend HTTPS API（推荐 Hobby）：
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxx
# MAIL_FROM_ADDRESS=你在 Resend 已验证域名下的发件地址
# MAIL_FROM_NAME="AI 用例平台"
# 文档：https://docs.railway.com/reference/outbound-networking
#
# ---------- Outlook / Microsoft 365 / Outlook.com（需 Pro+ 或他机 SMTP）----------
# 个人邮箱（@outlook.com、@hotmail.com、@live.com 等）常用：
# MAIL_HOST=smtp-mail.outlook.com
# Microsoft 365 工作/学校邮箱常用：
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=完整邮箱（与发信身份一致）
# MAIL_PASSWORD=账户密码；若已开双重验证，用微软账号「应用密码」
# MAIL_FROM_ADDRESS=与 MAIL_USERNAME 相同（避免拒信）
# MAIL_FROM_NAME="AI 用例平台"
# M365：部分租户需在管理员中心开启「SMTP AUTH」后客户端 SMTP 才可用；仍失败可试 MAIL_PORT=465 + MAIL_ENCRYPTION=ssl
#
# ---------- Laravel 风格 MAIL_*（与上方 Outlook 示例变量名一致，可对照填写）----------
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-mail.outlook.com
# MAIL_PORT=587
# MAIL_USERNAME=you@outlook.com
# MAIL_PASSWORD=应用密码或账户密码
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS 须与 MAIL_USERNAME 一致（笔误易导致拒信）
# MAIL_FROM_ADDRESS=you@outlook.com
# MAIL_FROM_NAME="AI 用例平台"
# Railway 等若日志出现 connect ENETUNREACH 240d:...:587：后端会对 MAIL_HOST 做 A 记录解析并用 IPv4 连接，同时 TLS SNI 仍用原主机名
# MAIL_SMTP_IPV4FIRST=false
# 若 MAIL_HOST 直接填 SMTP 服务器 IPv4，证书校验需指定原名，例如：MAIL_TLS_SERVERNAME=smtp-mail.outlook.com
# MAIL_TLS_SERVERNAME=
#
# ---------- 兼容旧变量 SMTP_* ----------
# Gmail等其它服务商仅换 HOST/账号即可；开发环境未配置 SMTP 时验证码仍会写入库并在日志打印 [dev] 行
# SMTP_FROM=you@outlook.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP 连接/读写超时（毫秒）。默认 60s / 120s；仍 Connection timeout 多为网络或对数据中心 IP 限制
# SMTP_CONNECTION_TIMEOUT_MS=60000
# SMTP_SOCKET_TIMEOUT_MS=120000
# 若 587 长期超时，可试：MAIL_PORT=465 MAIL_ENCRYPTION=ssl

# Railway：migrate 默认在 preDeployCommand 执行；若要在 Web 容器启动时再跑一遍迁移则设为 1
# RAILWAY_MIGRATE_ON_START=1
# 排查：完全跳过启动时迁移（不推荐长期使用）
# SKIP_PRISMA_MIGRATE_ON_START=1
